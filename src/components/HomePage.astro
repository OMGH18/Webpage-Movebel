---
import { Image } from 'astro:assets'
import Base from '../layouts/Base.astro'
import StoreButtons from './StoreButtons.astro'
import PricingPanel from './PricingPanel.astro'
import Faq from './Faq.astro'
import CtaBand from './CtaBand.astro'
import CardFan from './CardFan.astro'
import stadium from '../assets/art/stadium.png'
import map from '../assets/art/map-monde.jpg'
import mascotGold from '../assets/art/mascot-gold.png'
import JourneyCover from './JourneyCover.astro'
import { FACTS, JOURNEYS, PRICES, SITE, formatDuration, formatNumber, formatPrice, journeyDays, type Lang } from '../data/product'
import { ROUTES } from '../i18n/ui'
import { app, faqPage, organization, website } from '../data/schema'

interface Props { lang: Lang }
const { lang } = Astro.props
const fr = lang === 'fr'
const p = (v: number) => formatPrice(v, lang)
const n = (v: number) => formatNumber(v, lang)
const longest = JOURNEYS[JOURNEYS.length - 1]
const inca = JOURNEYS.find((j) => j.id === 'inca-trail')!
const tdf = JOURNEYS.find((j) => j.id === 'tour-de-france')!

const c = fr
  ? {
      title: 'Movebel : marche pour ton pays, gratuit sur iPhone',
      description: `Movebel transforme tes pas en points pour ton pays : classement mondial entre ${FACTS.countries} pays, défis entre amis et voyages à pied. Gratuit sur iPhone, avec Apple Santé.`,
      h1a: 'Tu ne peux pas marquer pour ton pays.',
      h1b: 'Mais tu peux marcher pour lui.',
      lede: 'Movebel transforme tes pas en points pour ton pays.',
      lede2: `Choisis ton camp parmi ${FACTS.countries} pays, marche comme d’habitude, et regarde ton pays grimper au classement mondial.`,
      howCta: 'Comment ça marche',
      trust: [
        { t: 'Gratuit', s: 'Movebel+ en option', svg: 'M20 12v8a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1v-8M2 8h20v4H2zM12 21V8m0 0H7.5a2.5 2.5 0 1 1 0-5C11 3 12 8 12 8Zm0 0h4.5a2.5 2.5 0 1 0 0-5C13 3 12 8 12 8Z' },
        { t: `${FACTS.countries} pays`, s: 'Un seul classement mondial', svg: 'M12 3a9 9 0 1 0 0 18 9 9 0 0 0 0-18Zm-9 9h18M12 3c2.6 2.8 3.9 5.8 3.9 9s-1.3 6.2-3.9 9c-2.6-2.8-3.9-5.8-3.9-9S9.4 5.8 12 3Z' },
        { t: 'Apple Santé', s: 'Tes pas, sans rien saisir', svg: 'M12 20s-7-4.4-7-10a4 4 0 0 1 7-2.6A4 4 0 0 1 19 10c0 5.6-7 10-7 10Z' },
      ],
      howTitle: 'Tu règles tout une fois. Ensuite, tu marches.',
      steps: [
        { t: 'Choisis ton pays', s: `${FACTS.countries} pays au choix. C’est lui que tu représentes au classement.` },
        { t: 'Connecte Apple Santé', s: 'Tes pas arrivent tout seuls, rien à saisir.' },
        { t: 'Marche comme d’habitude', s: 'Le trajet au travail, les courses, la balade du soir : tout compte pour ton pays.' },
      ],
      feats: [
        { t: 'Ta série', s: 'Atteins ton objectif chaque jour et garde la flamme. Avec Movebel+, un bouclier par mois protège un jour manqué.', mock: 'streak' },
        { t: 'Badges et grades', s: 'Tes premiers 10 000 pas, tes séries, tes saisons : chaque palier se débloque en marchant.', mock: 'badges' },
        { t: 'Le widget', s: 'Tes pas du jour sur l’écran d’accueil, sans ouvrir l’app.', mock: 'widget' },
      ],
      streakLabel: 'jours de suite',
      widgetLabel: 'pas aujourd’hui',
      badges: ['10 000 pas', '7 jours', 'Saison'],
      shows: [
        { title: 'Classement mondial', capT: 'Ton pays contre le reste du monde', capS: 'Le classement bouge avec les pas de chaque marcheur.' },
        { title: 'Voyages', capT: 'Tes pas deviennent un voyage', capS: 'Ta marche du jour te fait avancer sur une vraie carte, ville après ville.' },
        { title: 'Défis', capT: 'Qui marche le plus cette semaine ?', capS: 'Crée un défi, envoie le lien, et la course commence.' },
      ],
      journeysTitle: 'Jusqu’où iront tes pas ?',
      journeysSub: `${JOURNEYS.length} voyages, de ${n(JOURNEYS[0].km)} à ${n(longest.km)} km. À 10 000 pas par jour, le Chemin de l’Inca se boucle en ${formatDuration(journeyDays(inca.km), lang)}, le Tour de France en ${formatDuration(journeyDays(tdf.km), lang, true)}.`,
      journeysNote: 'Lumière est gratuit ; les autres voyages font partie de Movebel+. Durées estimées à 10 000 pas par jour.',
      free: 'Gratuit', stagesWord: 'étapes',
      freeLead: 'Ton premier voyage est offert : une île imaginaire en six étapes, pour voir tes pas avancer sur la carte dès le premier jour.',
      chTitleA: 'Tes amis,', chTitleB: 'ton meilleur coach.',
      chBody: `Crée un défi en quelques secondes (par défaut ${FACTS.challengeTemplate.days} jours et ${n(FACTS.challengeTemplate.steps)} pas chacun), partage le lien, et voyez qui tient la distance.`,
      chList: [
        `Gratuit : ${FACTS.challengeFree.active} défi actif, jusqu’à ${FACTS.challengeFree.members} marcheurs`,
        `Movebel+ : ${FACTS.challengePremium.active} défis actifs, jusqu’à ${FACTS.challengePremium.members} marcheurs`,
        'Rejoindre le défi d’un ami est toujours gratuit',
        `Un ami parrainé : +${n(FACTS.referralBonusSteps)} pas bonus pour vous deux`,
      ],
      priceTitleA: 'Gratuit pour marcher.', priceTitleB: 'Movebel+ pour voyager.',
      faqTitle: 'Questions fréquentes',
      faq: [
        { q: 'Movebel est-il gratuit ?', a: `Oui. Choisir ton pays, faire monter son classement, garder ta série, gagner des badges, faire le voyage Lumière et créer un défi entre amis sont gratuits. Movebel+ (${p(PRICES.monthly)} par mois ou ${p(PRICES.yearly)} par an, prix en France) ajoute les autres voyages, des défis plus grands et le bouclier de série.` },
        { q: 'Comment mes pas sont-ils comptés ?', a: 'Movebel lit ton nombre de pas dans Apple Santé, avec ton autorisation. Tu n’as rien à saisir : tes pas du jour s’ajoutent au total de ton pays.' },
        { q: 'Movebel est-il disponible sur Android ?', a: 'Pas pour l’instant : Movebel est disponible sur iPhone, en français et en anglais.' },
        { q: 'Comment fonctionnent les voyages ?', a: `Tu choisis un parcours réel (Tour de France, Route 66, Chemin de Compostelle…) et tes pas te font avancer d’étape en étape. Un voyage est actif à la fois. Lumière (${FACTS.freeJourneyKm} km) est gratuit, les autres sont inclus dans Movebel+.` },
        { q: 'Comment fonctionne un défi entre amis ?', a: `Tu fixes un objectif et des dates, tu partages le lien d’invitation, et chacun voit la progression du groupe. En gratuit, un défi actif jusqu’à ${FACTS.challengeFree.members} marcheurs ; avec Movebel+, jusqu’à ${FACTS.challengePremium.active} défis et ${FACTS.challengePremium.members} marcheurs. Rejoindre un défi est gratuit.` },
        { q: 'Que se passe-t-il si je rate un jour ?', a: 'Ta série repart à zéro. Avec Movebel+, un bouclier par mois peut protéger un seul jour manqué, si tu valides tes pas dès le lendemain.' },
      ],
    }
  : {
      title: 'Movebel: step up for your country, free on iPhone',
      description: `Movebel turns your steps into points for your country: a leaderboard across ${FACTS.countries} countries, challenges with friends and walking journeys. Free on iPhone.`,
      h1a: 'You can’t score for your country.',
      h1b: 'But you can walk for it.',
      lede: 'Movebel turns your steps into points for your country.',
      lede2: `Pick your side among ${FACTS.countries} countries, walk as usual, and watch your country climb the global leaderboard.`,
      howCta: 'How it works',
      trust: [
        { t: 'Free', s: 'Movebel+ is optional', svg: 'M20 12v8a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1v-8M2 8h20v4H2zM12 21V8m0 0H7.5a2.5 2.5 0 1 1 0-5C11 3 12 8 12 8Zm0 0h4.5a2.5 2.5 0 1 0 0-5C13 3 12 8 12 8Z' },
        { t: `${FACTS.countries} countries`, s: 'One global leaderboard', svg: 'M12 3a9 9 0 1 0 0 18 9 9 0 0 0 0-18Zm-9 9h18M12 3c2.6 2.8 3.9 5.8 3.9 9s-1.3 6.2-3.9 9c-2.6-2.8-3.9-5.8-3.9-9S9.4 5.8 12 3Z' },
        { t: 'Apple Health', s: 'Your steps, no typing', svg: 'M12 20s-7-4.4-7-10a4 4 0 0 1 7-2.6A4 4 0 0 1 19 10c0 5.6-7 10-7 10Z' },
      ],
      howTitle: 'Set it up once. Then just walk.',
      steps: [
        { t: 'Pick your country', s: `${FACTS.countries} countries to choose from. That’s who you walk for.` },
        { t: 'Connect Apple Health', s: 'Your steps come in on their own, nothing to type.' },
        { t: 'Walk as usual', s: 'The commute, the groceries, the evening stroll: it all counts for your country.' },
      ],
      feats: [
        { t: 'Your streak', s: 'Hit your goal every day and keep the flame alive. With Movebel+, one shield a month protects a missed day.', mock: 'streak' },
        { t: 'Badges and ranks', s: 'Your first 10,000 steps, your streaks, your seasons: every milestone unlocks as you walk.', mock: 'badges' },
        { t: 'The widget', s: 'Today’s steps on your home screen, without opening the app.', mock: 'widget' },
      ],
      streakLabel: 'days in a row',
      widgetLabel: 'steps today',
      badges: ['10,000 steps', '7 days', 'Season'],
      shows: [
        { title: 'Global leaderboard', capT: 'Your country against the world', capS: 'The leaderboard moves with every walker’s steps.' },
        { title: 'Journeys', capT: 'Your steps become a journey', capS: 'Today’s walk moves you along a real map, city after city.' },
        { title: 'Challenges', capT: 'Who walks the most this week?', capS: 'Create a challenge, send the link, and the race is on.' },
      ],
      journeysTitle: 'How far will your steps take you?',
      journeysSub: `${JOURNEYS.length} journeys, from ${n(JOURNEYS[0].km)} to ${n(longest.km)} km. At 10,000 steps a day, the Inca Trail takes ${formatDuration(journeyDays(inca.km), lang)} and the Tour de France ${formatDuration(journeyDays(tdf.km), lang, true)}.`,
      journeysNote: 'Lumière is free; the other journeys come with Movebel+. Durations estimated at 10,000 steps a day.',
      free: 'Free', stagesWord: 'stages',
      freeLead: 'Your first journey is on us: an imaginary island in six stages, so you see your steps move on the map from day one.',
      chTitleA: 'Your friends,', chTitleB: 'your best coach.',
      chBody: `Create a challenge in seconds (${FACTS.challengeTemplate.days} days and ${n(FACTS.challengeTemplate.steps)} steps each by default), share the link, and see who goes the distance.`,
      chList: [
        `Free: ${FACTS.challengeFree.active} active challenge, up to ${FACTS.challengeFree.members} walkers`,
        `Movebel+: ${FACTS.challengePremium.active} active challenges, up to ${FACTS.challengePremium.members} walkers`,
        'Joining a friend’s challenge is always free',
        `Invite a friend: +${n(FACTS.referralBonusSteps)} bonus steps for both of you`,
      ],
      priceTitleA: 'Free to walk.', priceTitleB: 'Movebel+ to travel.',
      faqTitle: 'FAQ',
      faq: [
        { q: 'Is Movebel free?', a: `Yes. Picking your country, pushing it up the leaderboard, keeping your streak, earning badges, walking the Lumière journey and creating a challenge with friends are free. Movebel+ (${p(PRICES.monthly)} per month or ${p(PRICES.yearly)} per year, prices in France) adds the other journeys, bigger challenges and the streak shield.` },
        { q: 'How are my steps counted?', a: 'Movebel reads your step count from Apple Health, with your permission. Nothing to type: today’s steps add to your country’s total.' },
        { q: 'Is Movebel available on Android?', a: 'Not yet: Movebel is available on iPhone, in English and French.' },
        { q: 'How do journeys work?', a: `You pick a real route (Tour de France, Route 66, Camino de Santiago…) and your steps move you from stage to stage. One journey is active at a time. Lumière (${FACTS.freeJourneyKm} km) is free, the others come with Movebel+.` },
        { q: 'How does a challenge with friends work?', a: `You set a goal and dates, share the invite link, and everyone sees the group’s progress. Free: one active challenge with up to ${FACTS.challengeFree.members} walkers; with Movebel+, up to ${FACTS.challengePremium.active} challenges and ${FACTS.challengePremium.members} walkers. Joining a challenge is free.` },
        { q: 'What if I miss a day?', a: 'Your streak resets. With Movebel+, one shield a month can protect a single missed day, if you validate your steps the next day.' },
      ],
    }

const path = ROUTES.home[lang]
const jsonLd = [organization(), website(), app(lang), faqPage(`${SITE}${path}#faq`, c.faq)]
const avatars = [
  { i: 'L', c: '#f97316' }, { i: 'M', c: '#d946ef' }, { i: 'S', c: '#3b82f6' }, { i: 'A', c: '#10b981' }, { i: 'J', c: '#fbbf24' },
]
---

<Base lang={lang} title={c.title} description={c.description} path={path} alternates={{ fr: ROUTES.home.fr, en: ROUTES.home.en }} jsonLd={jsonLd}>
  <div class="wrap stack">
    <!-- HERO -->
    <section class="hero">
      <div class="hero-bg" aria-hidden="true"><Image src={stadium} alt="" width={1100} quality={60} loading="eager" /></div>
      <div class="hero-copy">
        <h1 class="display">{c.h1a} <span class="hl">{c.h1b}</span></h1>
        <p class="hero-lede"><strong>{c.lede}</strong> {c.lede2}</p>
        <StoreButtons lang={lang} note={false}>
          <a class="btn btn-ghost try" href="#how">{c.howCta} <span aria-hidden="true">↓</span></a>
        </StoreButtons>
        <ul class="trust">
          {c.trust.map((tr) => (
            <li>
              <span class="ti"><svg viewBox="0 0 24 24" aria-hidden="true"><path d={tr.svg} fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" /></svg></span>
              <span><b>{tr.t}</b><small>{tr.s}</small></span>
            </li>
          ))}
        </ul>
      </div>
      <div class="hero-art"><CardFan lang={lang} /></div>
    </section>

    <!-- COMMENT ÇA MARCHE + FONCTIONNALITÉS -->
    <section class="bento" id="how">
      <article class="how reveal">
        <div class="how-body">
          <h2 class="display">{c.howTitle}</h2>
          <ol class="steps">
            {c.steps.map((st, i) => (
              <li><span class="sn">{i + 1}</span><span><b>{st.t}</b><small>{st.s}</small></span></li>
            ))}
          </ol>
        </div>
        <div class="how-art" aria-hidden="true">
          <svg class="prints" viewBox="0 0 200 320">
            {[[40, 300, -18], [78, 272, 12], [62, 232, -14], [102, 206, 16], [86, 166, -10], [128, 142, 20]].map(([x, y, r], k) => (
              <g transform={`translate(${x} ${y}) rotate(${r})`} opacity={0.18 + k * 0.1}><ellipse rx="7" ry="12" /><circle cx="-4" cy="-17" r="2.4" /><circle cx="0" cy="-19" r="2.6" /><circle cx="4.4" cy="-17.4" r="2.3" /></g>
            ))}
          </svg>
          <Image class="how-mascot" src={mascotGold} alt="" width={260} loading="lazy" />
        </div>
      </article>
      <div class="feats">
        {c.feats.map((f) => (
          <div class="card feat reveal">
            <div><h3>{f.t}</h3><p>{f.s}</p></div>
            {f.mock === 'streak' && (
              <div class="mock streak" aria-hidden="true">
                <svg viewBox="0 0 24 24"><path d="M12 22c4 0 7-2.7 7-6.6 0-3.6-2.4-5.6-3.6-8.4-.4 1.8-1.4 3-2.6 3.4.3-3.2-1-6-3.8-8.4.2 3.4-1.4 5.4-3 7.2C4.9 10.5 5 12.8 5 15.4 5 19.3 8 22 12 22Z" /></svg>
                <span><b>12</b><small>{c.streakLabel}</small></span>
              </div>
            )}
            {f.mock === 'badges' && (
              <div class="mock badges" aria-hidden="true">{c.badges.map((b, k) => <span class={`b b${k}`}>{b}</span>)}</div>
            )}
            {f.mock === 'widget' && (
              <div class="mock widget" aria-hidden="true"><b>{n(8214)}</b><small>{c.widgetLabel}</small><span class="wbar"><i></i></span></div>
            )}
          </div>
        ))}
      </div>
    </section>

    <!-- VITRINES -->
    <section class="shows">
      <figure class="show reveal">
        <div class="art a-rank">
          <Image class="sbg" src={map} alt="" width={800} loading="lazy" />
          <p class="stitle">{c.shows[0].title}</p>
          <span class="pin p1"></span><span class="pin p2"></span><span class="pin p3"></span><span class="pin p4"></span><span class="pin p5"></span>
        </div>
        <figcaption><b>{c.shows[0].capT}</b><span>{c.shows[0].capS}</span></figcaption>
      </figure>
      <figure class="show reveal">
        <div class="art a-trip">
          <JourneyCover id="tour-de-france" class="sbg" />
          <p class="stitle">{c.shows[1].title}</p>
          <div class="leg-card">
            <div class="leg-top"><b>Tour de France</b><span>{n(910)} / {n(tdf.km)} km</span></div>
            <div class="leg-track"><i style="width:38%"></i>{[0, 9.4, 20.4, 37.9, 51, 68, 78, 92.7, 100].map((x, k) => <span class:list={['dot', { done: x <= 37.9, now: k === 3 }]} style={`left:${x}%`}></span>)}</div>
            <div class="leg-cities"><span>Paris</span><span class="cur">Lyon</span><span>Paris</span></div>
          </div>
        </div>
        <figcaption><b>{c.shows[1].capT}</b><span>{c.shows[1].capS}</span></figcaption>
      </figure>
      <figure class="show reveal">
        <div class="art a-chal">
          <Image class="sbg" src={stadium} alt="" width={800} loading="lazy" />
          <p class="stitle">{c.shows[2].title}</p>
          <div class="avrow">{avatars.map((a) => <span style={`--c:${a.c}`}>{a.i}</span>)}</div>
        </div>
        <figcaption><b>{c.shows[2].capT}</b><span>{c.shows[2].capS}</span></figcaption>
      </figure>
    </section>

    <!-- VOYAGES -->
    <section class="journeys" id="journeys">
      <div class="sec-head"><h2 class="display">{c.journeysTitle}</h2><p>{c.journeysSub}</p></div>
      <ul class="jgrid">
        {JOURNEYS.map((j) => (
          <li class:list={['jcard', { free: j.free }]}>
            <div class="jart">
              <JourneyCover id={j.id} />
              <span class="jkm">{n(j.km)} km</span>
              {j.free && <span class="tag">{c.free}</span>}
              {j.season && <span class="tag season">{fr ? j.season.fr : j.season.en}</span>}
            </div>
            <div class="jbody">
              <b class="jname">{fr ? j.fr : j.en}</b>
              <span class="jroute">{fr ? j.route.fr : j.route.en}</span>
              {j.free && <p class="jlead">{c.freeLead}</p>}
              <span class="jmeta"><span>{j.stops} {c.stagesWord}</span><span>{formatDuration(journeyDays(j.km), lang)}</span></span>
            </div>
          </li>
        ))}
      </ul>
      <p class="jnote">{c.journeysNote}</p>
    </section>

    <!-- DÉFIS -->
    <section class="panel chal reveal" id="challenges">
      <div>
        <h2 class="display">{c.chTitleA} <span class="hl">{c.chTitleB}</span></h2>
        <p class="muted">{c.chBody}</p>
        <ul class="check">{c.chList.map((li) => <li>{li}</li>)}</ul>
      </div>
      <div class="well chal-mock" aria-hidden="true">
        {avatars.slice(0, 4).map((a, k) => (
          <div class="crow"><span class="cav" style={`--c:${a.c}`}>{a.i}</span><span class="cbar"><i style={`width:${[100, 84, 66, 47][k]}%;background:${a.c}`}></i></span><b>{n([35000, 29400, 23100, 16450][k])}</b></div>
        ))}
      </div>
    </section>

    <!-- PRIX -->
    <section class="price-sec" id="prix">
      <h2 class="display">{c.priceTitleA} <span class="hl">{c.priceTitleB}</span></h2>
      <PricingPanel lang={lang} />
    </section>
  </div>

  <Faq items={c.faq} title={c.faqTitle} />
  <CtaBand lang={lang} />
</Base>

<style>
  .stack { display: grid; gap: clamp(16px, 2.4vw, 28px); padding-top: 16px; }

  /* ---------- HERO ---------- */
  .hero { position: relative; isolation: isolate; display: grid; gap: 28px; align-items: center; padding: clamp(24px, 5vw, 64px) 0 clamp(12px, 3vw, 32px); }
  @media (min-width: 900px) { .hero { grid-template-columns: 1.08fr 1fr; gap: 24px; min-height: 560px; } }
  .hero-bg { position: absolute; z-index: -1; inset: -16px calc(-1 * var(--gutter)) 0; overflow: hidden; pointer-events: none; }
  .hero-bg :global(img) {
    position: absolute; right: 0; top: 0; width: min(980px, 100%); height: 100%; object-fit: cover; object-position: 50% 40%;
    opacity: 0.42; filter: saturate(0.8) hue-rotate(20deg);
    mask-image: radial-gradient(70% 75% at 70% 40%, #000, transparent 75%);
    -webkit-mask-image: radial-gradient(70% 75% at 70% 40%, #000, transparent 75%);
  }
  .hero-bg::after { content: ''; position: absolute; inset: 0; background: radial-gradient(40% 50% at 75% 45%, rgba(124, 58, 237, 0.22), transparent 70%); }
  .hero h1 { font-size: clamp(34px, 4.3vw, 58px); }
  .hero h1 .hl { display: block; margin-top: 4px; }
  .hero-lede { color: var(--muted); font-size: clamp(16px, 1.5vw, 18px); margin: 24px 0 26px; max-width: 560px; }
  .hero-lede strong { color: var(--text); font-weight: 600; }
  .try { min-height: 54px; padding: 0 20px; font-size: 16px; border-radius: 14px; }
  .trust { list-style: none; margin: 30px 0 0; padding: 22px 0 0; border-top: 1px solid var(--border); display: grid; gap: 14px; grid-template-columns: 1fr; max-width: 640px; }
  @media (min-width: 560px) { .trust { grid-template-columns: repeat(3, 1fr); gap: 16px; } }
  .trust li { display: flex; align-items: center; gap: 11px; }
  .ti { width: 38px; height: 38px; flex: none; display: grid; place-items: center; border-radius: 11px; background: rgba(124, 58, 237, 0.14); border: 1px solid rgba(124, 58, 237, 0.35); color: #c4b5fd; }
  .ti svg { width: 19px; height: 19px; }
  .trust b { display: block; font-family: var(--font-display); font-weight: 600; font-size: 15px; line-height: 1.25; }
  .trust small { display: block; color: var(--faint); font-size: 13px; line-height: 1.3; }
  .hero-art { position: relative; overflow-x: clip; overflow-y: visible; padding: 0 6px; }
  @media (max-width: 899px) { .hero-art { order: -1; margin: 0 auto -6px; width: 100%; max-width: 420px; } }

  /* ---------- BENTO ---------- */
  .bento { display: grid; gap: 12px; scroll-margin-top: 80px; }
  @media (min-width: 1000px) { .bento { grid-template-columns: 1.15fr 1fr; gap: 16px; } }
