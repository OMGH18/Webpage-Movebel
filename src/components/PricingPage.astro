---
import Base from '../layouts/Base.astro'
import CtaBand from './CtaBand.astro'
import Faq from './Faq.astro'
import PricingPanel from './PricingPanel.astro'
import { FACTS, JOURNEYS, PRICES, SITE, formatPrice, type Lang } from '../data/product'
import { ROUTES } from '../i18n/ui'
import { breadcrumbs, faqPage, webPage } from '../data/schema'

interface Props { lang: Lang }
const { lang } = Astro.props
const fr = lang === 'fr'
const p = (v: number) => formatPrice(v, lang)
const path = ROUTES.pricing[lang]

const c = fr
  ? {
      title: 'Prix de Movebel : gratuit, et Movebel+ en option',
      description: `Movebel est gratuit. Movebel+ coûte ${p(PRICES.monthly)} par mois ou ${p(PRICES.yearly)} par an et ajoute les voyages, des défis plus grands et le bouclier de série. Le détail.`,
      eyebrow: 'Prix',
      h1: 'Combien coûte Movebel ?',
      lede: `<strong>Movebel est gratuit : tes pas comptent pour ton pays, tu gardes ta série et tu peux défier tes amis sans payer.</strong> Movebel+, en option, coûte ${p(PRICES.monthly)} par mois ou ${p(PRICES.yearly)} par an et ajoute les voyages, des défis plus grands et le bouclier de série.`,
      compareTitle: 'Gratuit ou Movebel+ : le détail',
      cols: ['', 'Gratuit', 'Movebel+'],
      rows: [
        ['Tes pas pour ton pays', 'Oui', 'Oui'],
        ['Classement mondial, séries, badges, grades', 'Oui', 'Oui'],
        ['Voyages', `Lumière (${FACTS.freeJourneyKm} km)`, `Les ${JOURNEYS.length} voyages, un à la fois`],
        ['Passeport de tampons', 'Tampons de Lumière', 'Tous les voyages'],
        ['Créer des défis', `${FACTS.challengeFree.active} défi actif, ${FACTS.challengeFree.members} marcheurs`, `${FACTS.challengePremium.active} défis actifs, ${FACTS.challengePremium.members} marcheurs`],
        ['Rejoindre un défi', 'Gratuit', 'Gratuit'],
        ['Bouclier de série', 'Non', 'Un par mois'],
        ['QG et archives des saisons', 'Aperçu du QG', 'QG en entier et archives'],
      ],
      extras: [
        { t: 'Le bouclier de série', b: 'Une fois par mois, le bouclier peut protéger un seul jour manqué : il suffit de valider tes pas dès le lendemain. Il ne se cumule pas d’un mois à l’autre.' },
        { t: 'Tes amis jouent gratuitement', b: 'Rejoindre un défi ne demande jamais d’abonnement : seules les limites du créateur du défi dépendent de Movebel+.' },
      ],
      faqTitle: 'Questions sur les prix',
      faq: [
        { q: 'Movebel est-il vraiment gratuit ?', a: `Oui. Tes pas comptent pour ton pays, le classement, les séries, les badges, le voyage Lumière et un défi entre amis sont gratuits. Movebel+ est une option.` },
        { q: 'Combien coûte Movebel+ ?', a: `${p(PRICES.monthly)} par mois ou ${p(PRICES.yearly)} par an en France (soit ${p(PRICES.yearlyPerMonth)} par mois). L’App Store affiche le prix exact dans ta devise avant l’achat.` },
        { q: 'Comment résilier Movebel+ ?', a: 'Depuis les réglages d’abonnement de ton compte Apple, à tout moment, au moins 24 heures avant la fin de la période en cours. Movebel+ reste actif jusqu’à la fin de la période payée.' },
        { q: 'Que deviennent mes voyages si j’arrête Movebel+ ?', a: 'Les tampons déjà gagnés restent dans ton passeport. Pour poursuivre un voyage Movebel+, il faut un abonnement actif ; Lumière reste gratuit.' },
      ],
    }
  : {
      title: 'Movebel pricing: free, with optional Movebel+',
      description: `Movebel is free. Movebel+ costs ${p(PRICES.monthly)} per month or ${p(PRICES.yearly)} per year and adds journeys, bigger challenges and the streak shield. The details.`,
      eyebrow: 'Pricing',
      h1: 'How much does Movebel cost?',
      lede: `<strong>Movebel is free: your steps count for your country, you keep your streak and you can challenge your friends without paying.</strong> The optional Movebel+ costs ${p(PRICES.monthly)} per month or ${p(PRICES.yearly)} per year and adds journeys, bigger challenges and the streak shield.`,
      compareTitle: 'Free vs Movebel+ in detail',
      cols: ['', 'Free', 'Movebel+'],
      rows: [
        ['Your steps for your country', 'Yes', 'Yes'],
        ['Global leaderboard, streaks, badges, ranks', 'Yes', 'Yes'],
        ['Journeys', `Lumière (${FACTS.freeJourneyKm} km)`, `All ${JOURNEYS.length} journeys, one at a time`],
        ['Stamp passport', 'Lumière stamps', 'Every journey'],
        ['Create challenges', `${FACTS.challengeFree.active} active, ${FACTS.challengeFree.members} walkers`, `${FACTS.challengePremium.active} active, ${FACTS.challengePremium.members} walkers`],
        ['Join a challenge', 'Free', 'Free'],
        ['Streak shield', 'No', 'One a month'],
        ['HQ and season archives', 'HQ preview', 'Full HQ and archives'],
      ],
      extras: [
        { t: 'The streak shield', b: 'Once a month, the shield can protect a single missed day: just validate your steps the next day. It does not roll over from one month to the next.' },
        { t: 'Your friends play for free', b: 'Joining a challenge never requires a subscription: only the challenge creator’s limits depend on Movebel+.' },
      ],
      faqTitle: 'Pricing questions',
      faq: [
        { q: 'Is Movebel really free?', a: 'Yes. Your steps count for your country, and the leaderboard, streaks, badges, the Lumière journey and one challenge with friends are free. Movebel+ is optional.' },
        { q: 'How much is Movebel+?', a: `${p(PRICES.monthly)} per month or ${p(PRICES.yearly)} per year in France (${p(PRICES.yearlyPerMonth)} per month). The App Store shows the exact price in your currency before you buy.` },
        { q: 'How do I cancel Movebel+?', a: 'From the subscription settings of your Apple account, at any time, at least 24 hours before the end of the current period. Movebel+ stays active until the end of the paid period.' },
        { q: 'What happens to my journeys if I stop Movebel+?', a: 'Stamps you already earned stay in your passport. Continuing a Movebel+ journey requires an active subscription; Lumière stays free.' },
      ],
    }

const jsonLd = [
  webPage(path, c.title, lang),
  breadcrumbs([{ name: 'Movebel', path: ROUTES.home[lang] }, { name: c.eyebrow, path }]),
  faqPage(`${SITE}${path}#faq`, c.faq),
]
---

<Base lang={lang} title={c.title} description={c.description} path={path} alternates={{ fr: ROUTES.pricing.fr, en: ROUTES.pricing.en }} jsonLd={jsonLd}>
  <section class="section top">
    <div class="glow" aria-hidden="true"></div>
    <div class="wrap">
      <div class="section-head">
        <h1 class="display">{c.h1}</h1>
        <p class="lede" set:html={c.lede} />
      </div>
      <PricingPanel lang={lang} showDetailsLink={false} />
    </div>
  </section>

  <section class="section compare">
    <div class="wrap">
      <div class="section-head"><h2 class="display">{c.compareTitle}</h2></div>
      <div class="table-wrap">
        <table>
          <thead><tr>{c.cols.map((col) => <th scope="col">{col}</th>)}</tr></thead>
          <tbody>{c.rows.map((r) => <tr><td>{r[0]}</td><td>{r[1]}</td><td>{r[2]}</td></tr>)}</tbody>
        </table>
      </div>
      <div class="grid-2 extras">
        {c.extras.map((e) => <div class="card extra"><h3>{e.t}</h3><p class="muted">{e.b}</p></div>)}
      </div>
    </div>
  </section>

  <Faq items={c.faq} title={c.faqTitle} />
  <CtaBand lang={lang} />
</Base>

<style>
  .top { overflow: hidden; }
  .glow { position: absolute; top: -40%; left: 30%; width: 900px; height: 900px; max-width: 120vw; background: radial-gradient(closest-side, rgba(124, 58, 237, 0.3), transparent); pointer-events: none; }
  .top .wrap { position: relative; }
  .top .section-head { margin-bottom: 26px; }
  .compare { padding-top: 0; }
  .extras { margin-top: 14px; }
  .extra { padding: 22px; }
  .extra h3 { margin-bottom: 6px; }
  .extra p { margin: 0; }
</style>
